# Required: generate a unique random secret; do not commit real values.
JWT_SECRET=replace-with-a-long-random-secret

# Optional database connection. If unset, the app uses local SQLite.
# DATABASE_URL=postgresql://user:password@host:5432/database

# Set strong passwords explicitly before seed accounts are created.
# No admin/worker seed accounts are created when these are blank.
ADMIN_EMAIL=admin@bookvault.com
ADMIN_PASSWORD=
WORKER_EMAIL=worker@bookvault.com
WORKER_PASSWORD=

# Optional Backblaze B2 / S3-compatible storage.
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET_NAME=
B2_ENDPOINT=

# Optional display configuration.
CASHAPP_HANDLE=
